{
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RisPNG/super-image-cropper.git"
  },
  "author": "STDSuperman <2750556766@qq.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "prepare": "npm run build",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format:fix": "prettier --write **/*.ts",
    "clean": "npm run clean --workspaces",
    "build": "npm run build --workspace=packages/gif-worker-js && npm run build --workspace=packages/super-image-cropper",
    "format": "prettier --write **/*.ts",
    "release": "tsx ./scripts/release/index.ts",
    "check": "npm run check --workspaces && tsc --noEmit -p scripts/tsconfig.json",
    "test": "npm run build && node --test packages/*/test/*_test.mjs scripts/test/*_test.mjs"
  },
  "devDependencies": {
    "@jsquash/webp": "1.5.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "^4.29.3",
    "@typescript-eslint/parser": "^4.29.3",
    "cropperjs-v1": "npm:cropperjs@1.6.2",
    "enquirer": "^2.3.6",
    "esbuild": "0.28.2",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.24.2",
    "execa": "^6.1.0",
    "prettier": "^2.3.2",
    "rimraf": "^3.0.2",
    "rollup": "4.64.6",
    "rollup-plugin-typescript2": "0.37.0",
    "semver": "^7.3.8",
    "tslib": "^2.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "cropperjs": "^2.3.0",
    "gif.js": "0.2.0",
    "gifuct-js": "2.1.2",
    "image-type": "4.1.0"
  },
  "name": "super-image-cropper",
  "version": "1.0.27",
  "description": "A powerful JavaScript image cropping library that supports GIF animations, PNG, JPG and other formats with CropperJS integration. Perfect for web developers who need to crop animated GIFs while preserving animation quality.",
  "type": "module",
  "main": "./packages/super-image-cropper/dist/index.cjs",
  "module": "./packages/super-image-cropper/esm/index.js",
  "types": "./packages/super-image-cropper/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./packages/super-image-cropper/esm/index.d.ts",
        "default": "./packages/super-image-cropper/esm/index.js"
      },
      "require": {
        "types": "./packages/super-image-cropper/dist/index.d.ts",
        "default": "./packages/super-image-cropper/dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/super-image-cropper/dist",
    "packages/super-image-cropper/esm",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "workspaces": [
    "packages/*"
  ]
}
