{
  "name": "gif-build-worker-js",
  "version": "1.0.3",
  "main": "dist/index.cjs",
  "module": "esm/index.js",
  "type": "module",
  "types": "esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "esm",
    "package.json",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "clean": "rimraf dist esm",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "prebuild": "npm run clean",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "typescript": "5.9.3"
  },
  "dependencies": {}
}
